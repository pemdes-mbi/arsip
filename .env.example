GOOGLE_DRIVE_CREDENTIALS=credentials/service_account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-folder-id-here
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-script-id-here/exec
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_PROXY_SSL_HEADER=True
