# ==========================================
# SISTEM ARSIP DESA - ENVIRONMENT TEMPLATE
# ==========================================

# --- Django Core Configuration ---
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- HTTPS & Security Hardening (Production) ---
# For Local Development (HTTP):
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False
# DJANGO_SECURE_HSTS_SECONDS=0
#
# For Live Production (HTTPS):
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_PROXY_SSL_HEADER=True

# --- Google Apps Script / Drive Integration ---
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-script-deployment-id/exec
